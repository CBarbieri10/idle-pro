generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Fase 0: Fundação ──────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ANALYST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  ANALYST
}

// ─── Fase 1: Entidades Core ────────────────────────────────────────────────

model League {
  id        String   @id @default(cuid())
  name      String
  country   String
  season    String // ex: "2025/2026"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams   Team[]
  matches Match[]

  @@map("leagues")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  shortName String? // ex: "FLA", "PAL"
  country   String
  city      String?
  leagueId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league          League?   @relation(fields: [leagueId], references: [id])
  athletes        Athlete[] @relation("ClubAthletes")
  national        Athlete[] @relation("NationalAthletes")
  matches         Match[]   @relation("MatchTeam")
  opponentMatches Match[]   @relation("MatchOpponent")

  @@map("teams")
}

enum Position {
  GOALKEEPER
  RIGHT_BACK
  CENTER_BACK
  LEFT_BACK
  DEFENSIVE_MID
  CENTRAL_MID
  ATTACKING_MID
  RIGHT_WING
  LEFT_WING
  STRIKER
  FORWARD
}

enum FootPreference {
  RIGHT
  LEFT
  BOTH
}

model Athlete {
  id                  String         @id @default(cuid())
  name                String
  position            Position
  birthDate           DateTime?
  nationality         String?
  height              Int? // cm
  weight              Int? // kg
  footPreference      FootPreference @default(RIGHT)
  photoUrl            String? // foto de perfil
  photoHasAlpha       Boolean        @default(false) // PNG/WebP com fundo transparente
  actionPhotoUrl      String? // foto de ação
  actionPhotoHasAlpha Boolean        @default(false)
  notes               String?
  teamId              String
  nationalTeamId      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  team         Team              @relation("ClubAthletes", fields: [teamId], references: [id])
  nationalTeam Team?             @relation("NationalAthletes", fields: [nationalTeamId], references: [id])
  rawMetrics   RawMetric[]
  canonicalMetrics CanonicalMetric[]

  @@map("athletes")
}

// ─── Fase 2: Métricas ──────────────────────────────────────────────────────

enum MatchVenue {
  HOME
  AWAY
  NEUTRAL
}

enum MetricSource {
  MANUAL
  WYSCOUT
  SOFASCORE
  SPORTSBASE
  OTHER
}

model Match {
  id           String     @id @default(cuid())
  date         DateTime
  teamId       String // clube de referência (perspectiva do resultado)
  opponentId   String? // adversário cadastrado (opcional)
  opponentName String // nome exibido — sempre preenchido
  venue        MatchVenue @default(HOME)
  competition  String // ex: "Brasileirão Série A", "Copa do Brasil"
  leagueId     String?
  round        String? // ex: "Rodada 12", "Oitavas - Ida"
  goalsFor     Int?
  goalsAgainst Int?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  team             Team              @relation("MatchTeam", fields: [teamId], references: [id])
  opponent         Team?             @relation("MatchOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  league           League?           @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  rawMetrics       RawMetric[]
  canonicalMetrics CanonicalMetric[]

  @@index([date])
  @@index([teamId])
  @@map("matches")
}

/// Métrica Bruta (ADR-002): dado exatamente como veio da fonte, em JSONB.
model RawMetric {
  id            String       @id @default(cuid())
  matchId       String
  athleteId     String
  source        MetricSource @default(MANUAL)
  minutesPlayed Int?
  data          Json         @db.JsonB // { "goals": 1, "shots": 3, "Chutes para fora": 2, ... }
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  match            Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  athlete          Athlete           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  canonicalMetrics CanonicalMetric[]

  @@unique([matchId, athleteId, source])
  @@index([athleteId])
  @@map("raw_metrics")
}

/// Métrica Canônica (ADR-002, Issue #8 - T06): dado padronizado e normalizado para gráficos e comparações
model CanonicalMetric {
  id            String   @id @default(cuid())
  athleteId     String
  matchId       String
  rawMetricId   String?
  metricName    String // ex: "goals", "assists", "passes", "xg", "tackles"
  absoluteValue Float
  per90Value    Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  athlete   Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  rawMetric RawMetric? @relation(fields: [rawMetricId], references: [id], onDelete: SetNull)

  @@unique([matchId, athleteId, metricName])
  @@index([athleteId])
  @@index([matchId])
  @@index([metricName])
  @@map("canonical_metrics")
}

/// Template reutilizável de mapeamento de colunas (Issue #7 - T05b)
model MappingTemplate {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  source      MetricSource @default(OTHER)
  columns     Json         @db.JsonB // { [normalizedHeader: string]: { header: string, target: string } }
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("mapping_templates")
}
