# ═══════════════════════════════════════════════════════════════════════════════
# THE NET SCOUTING • VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (VERCEL + NEON)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. Banco de Dados (Neon PostgreSQL Serverless) ───────────────────────────
# Connection string do Neon com Pooling ativado (Host terminado em -pooler, sslmode=require)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-tiny-dew-acftku5g-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct URL para Prisma Migrations ou CLI em ambiente local (opcional)
# DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-tiny-dew-acftku5g.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── 2. Autenticação (NextAuth.js v5 / Auth.js) ───────────────────────────────
# URL canônica de produção na Vercel (ou http://localhost:3000 em dev)
NEXTAUTH_URL="https://thenetscouting.vercel.app"

# Chave secreta de criptografia para tokens JWT e cookies de sessão
# Gere uma chave segura via terminal: openssl rand -base64 32
AUTH_SECRET="your-32-char-random-secret-key-here"
NEXTAUTH_SECRET="your-32-char-random-secret-key-here"

# ─── 3. Configurações de Execução ─────────────────────────────────────────────
NODE_ENV="production"
